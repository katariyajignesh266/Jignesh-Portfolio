# Copy this file to .env and fill in your actual values.
# Local MongoDB (installed via mongod/mongosh on your machine):
MONGO_URI=mongodb://127.0.0.1:27017/taskmanager

# If using MongoDB Atlas instead, it would look like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskmanager

PORT=5000

# Practical 7 - JWT Authentication Configuration
# Set a strong secret key for signing JSON Web Tokens (NEVER commit the actual secret to git)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
